# 复制为 .env；不要提交真实凭据。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 2026-10-15 官方文档列出的图像模型；收到 Key 后实际探测账号能力。
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=true
# Diagram repair emits locked-math graphics without long reasoning.
DEEPSEEK_DIAGRAM_THINKING=false
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_MAX_TOKENS=12000
# 本服务的访问令牌，与 DeepSeek Key 完全不同。用 python -c "import secrets; print(secrets.token_urlsafe(32))" 生成。
AGENT_ACCESS_TOKEN=
AGENT_JOB_TIMEOUT=240
AGENT_MAX_MODEL_CALLS=10
AGENT_MAX_REPAIRS=2
# 实验版：有参考答案的旋转/平移题，数学与构图分开核验；不支持时明确失败。
AGENT_REFERENCE_MODE=false
AGENT_DATA_DIR=./data
# Docker Compose 会覆盖这两项为 /data 和 redis://redis:6379/0。
# 本机开发留空 Redis 时不启用缓存；正式部署使用 Compose 的 Redis。
REDIS_URL=
AGENT_CACHE_TTL=604800


# Optional private CPU OCR service (deploy/ocr)
AGENT_OCR_URL=
AGENT_OCR_TIMEOUT=240
AGENT_OCR_PROFILE=ppstructure3-v1
DEEPSEEK_SOURCE_MAX_TOKENS=8000

# Experimental serial re-review of changed proof questions and dependency closure.
# Requires AGENT_COMPACT_TOOLS=true; original images, all conditions and scenes remain.
AGENT_INCREMENTAL_MATH_REVIEW=false

# Experimental source-bound native construction obligations; independently review original pixels.
# Rotation/translation/intersection parents are checked before rendering, cache and publish.
AGENT_NATIVE_CONSTRUCTIONS=false
