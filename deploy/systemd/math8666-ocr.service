[Unit]
Description=Math Agent 8666 PaddleOCR and formulas
After=network-online.target
[Service]
User=math8666
Group=math8666
WorkingDirectory=/opt/math-agent-8666
EnvironmentFile=/opt/math-agent-8666/.env
Environment=HOME=/var/lib/math-agent-8666/models
Environment=PADDLE_PDX_MODEL_SOURCE=BOS
Environment=PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
Environment=OMP_NUM_THREADS=4
ExecStart=/opt/math-agent-8666/.ocr-venv/bin/python deploy/ocr/service.py
Restart=on-failure
RestartSec=10
MemoryMax=4G
CPUQuota=400%
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/math-agent-8666
[Install]
WantedBy=multi-user.target
