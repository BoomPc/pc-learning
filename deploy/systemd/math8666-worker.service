[Unit]
Description=Math Agent 8666 worker
After=network-online.target math8666-redis.service math8666-ocr.service
[Service]
User=math8666
Group=math8666
WorkingDirectory=/opt/math-agent-8666
EnvironmentFile=/opt/math-agent-8666/.env
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/math-agent-8666/browsers
ExecStart=/opt/math-agent-8666/.venv/bin/python -m math_agent.cli worker
Restart=on-failure
RestartSec=5
MemoryMax=2500M
CPUQuota=200%
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/math-agent-8666
KillMode=control-group
TimeoutStopSec=20
[Install]
WantedBy=multi-user.target
