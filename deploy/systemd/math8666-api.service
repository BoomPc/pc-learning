[Unit]
Description=Math Agent 8666 API
After=network-online.target
[Service]
User=math8666
Group=math8666
WorkingDirectory=/opt/math-agent-8666
EnvironmentFile=/opt/math-agent-8666/.env
ExecStart=/opt/math-agent-8666/.venv/bin/python -m math_agent.cli serve --host 0.0.0.0 --port 8666
Restart=on-failure
RestartSec=5
MemoryMax=1G
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/math-agent-8666
[Install]
WantedBy=multi-user.target
