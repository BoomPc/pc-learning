# Three model stages: source -> solve+native drawing -> combined review.
# OCR and browser checks are local/service operations, not extra model agents.
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=true
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_DIAGRAM_THINKING=true
DEEPSEEK_MAX_TOKENS=32000
AGENT_REFERENCE_MODE=false
AGENT_REVIEW_PLAN=false
AGENT_SOLVE_DRAFT=false
AGENT_JOB_TIMEOUT=240
AGENT_MAX_MODEL_CALLS=12
AGENT_MAX_REPAIRS=1
AGENT_COMPACT_TOOLS=true

# Restore full global output allowance; no early phase deadline.
DEEPSEEK_SOLVE_MAX_TOKENS=0
DEEPSEEK_REVIEW_MAX_TOKENS=0
AGENT_REVIEW_RESERVE_SECONDS=0

AGENT_INCREMENTAL_REVIEW=true
