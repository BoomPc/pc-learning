{
  "title": "JSXGraph 交互示例（人工样例，非模型生成）",
  "problem_text": "本页为人工编写的离线流程测试，不代表 DeepSeek 解题验收。已知抛物线 y=-x^2+2x。（1）求与 x 轴的交点 A、B。（2）P(t,-t^2+2t)，0≤t≤2，求△ABP面积最大值。端点展示退化情形。",
  "tabs": [
    {
      "tab_title": "第(1)问：求交点",
      "steps": [
        {
          "head": "令纵坐标为零",
          "content": "-x^2+2x=0，即 x(2-x)=0，因此 x=0 或 x=2。"
        }
      ],
      "conclusion": "A(0,0)，B(2,0)。",
      "board": {
        "bounding_box": [
          -0.7,
          2.2,
          3,
          -1
        ],
        "axis": true,
        "objects": [
          {
            "id": "A",
            "kind": "point",
            "coords": [
              0,
              0
            ]
          },
          {
            "id": "B",
            "kind": "point",
            "coords": [
              2,
              0
            ]
          },
          {
            "id": "f",
            "kind": "functiongraph",
            "expression": "-x**2+2*x",
            "domain": [
              -0.5,
              2.5
            ]
          }
        ]
      }
    },
    {
      "tab_title": "第(2)问：求最大面积",
      "controls": {
        "slider": {
          "min": 0,
          "max": 2,
          "step": 0.01,
          "default": 0.5,
          "label": "参数 t"
        },
        "solution_targets": [
          1
        ],
        "jump_buttons": [
          {
            "text": "跳转：t = 1",
            "value": 1,
            "is_target": true
          }
        ]
      },
      "steps": [
        {
          "head": "底乘高的一半",
          "content": "AB=2，P 到 x 轴的距离为 -t^2+2t，S=-t^2+2t。"
        },
        {
          "head": "配方求最大值",
          "content": "S=1-(t-1)^2≤1，t=1 时取等号。t=0 或 t=2 时面积为0，属于退化边界。"
        }
      ],
      "conclusion": "t=1 时最大面积为1。",
      "board": {
        "bounding_box": [
          -0.7,
          2.2,
          3,
          -1
        ],
        "axis": true,
        "objects": [
          {
            "id": "A",
            "kind": "point",
            "coords": [
              0,
              0
            ]
          },
          {
            "id": "B",
            "kind": "point",
            "coords": [
              2,
              0
            ]
          },
          {
            "id": "f",
            "kind": "functiongraph",
            "expression": "-x**2+2*x",
            "domain": [
              -0.5,
              2.5
            ]
          },
          {
            "id": "P",
            "kind": "point",
            "coords": [
              "t",
              "-t**2+2*t"
            ]
          },
          {
            "id": "ABP",
            "kind": "polygon",
            "parents": [
              "A",
              "B",
              "P"
            ],
            "color": "#69d6ad"
          }
        ]
      }
    }
  ],
  "format": "jsxgraph-v1"
}
